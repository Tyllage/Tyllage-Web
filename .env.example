# Copy to .env.local for local development. Only VITE_-prefixed variables are
# exposed to the browser bundle — never put secrets or private API keys here.

# Public HTTPS endpoint (e.g. AWS API Gateway → Lambda) that accepts enquiry
# submissions as JSON. Leave empty until the backend exists: the contact form
# then prepares a pre-filled email for the visitor to send themselves.
VITE_CONTACT_ENDPOINT=

# Production domain used for canonical URLs, Open Graph tags, structured data,
# robots.txt and sitemap.xml. Defaults to https://tyllage.org when unset.
VITE_SITE_URL=
